{
  "name": "bb-plugin-read-aloud",
  "version": "0.2.2",
  "type": "module",
  "engines": {
    "bb": ">=0.41",
    "bbPluginSdk": ">=0.4.34"
  },
  "bb": {
    "name": "Read Aloud",
    "description": "Adds a Read aloud action to every chat message: hear an agent's answer, or just the part you highlighted, in a natural OpenAI voice.",
    "branding": {
      "icon": "Volume2"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [],
    "host": "./host.ts"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.4.34",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.11.1",
    "cron-parser": "^5.10.0",
    "hono": "^4.13.7",
    "sonner": "^1.7.4",
    "typescript": "^5.7.0"
  },
  "description": "Speak any BB chat message aloud with OpenAI text-to-speech.",
  "license": "MIT",
  "scripts": {
    "build": "env -u BB_CLI bb plugin build .",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build"
  }
}
